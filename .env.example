# Fork 子路径部署（默认 /sublink，与 NPM location /sublink/ 对齐）
BASE_PATH=/sublink

# 公网域名与浏览器不一致时设置（仅 scheme+host+端口，勿带路径、勿末尾 /）
# 例：内网 subconverter 拉配置时用局域网，而管理页仍经公网打开
# PUBLIC_ORIGIN=http://192.168.0.6:58087
# PUBLIC_ORIGIN=https://houjia.mycloudnas.com:44

PORT=8787
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_KEY_PREFIX=sublink
CONFIG_TTL_SECONDS=2592000
